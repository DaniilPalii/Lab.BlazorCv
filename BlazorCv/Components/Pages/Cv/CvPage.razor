@page "/cv"
@using BlazorCv.Components.Shared.Loader
@using BlazorCv.Components.Pages.Cv.InfoRow
@using BlazorCv.Components.Pages.Cv.InfoRowLink
@using BlazorCv.Components.Pages.Cv.ProjectEntry
@using BlazorCv.Components.Pages.Cv.DateRange

<PageTitle>CV</PageTitle>

@if (cv is null)
{
	<Loader/>
}
else
{
	<div class="cv-container">
		<h1>@cv.Title</h1>

		<section>
			<h2>Personal Info</h2>
			<InfoRow Label="Name" Value="@cv.Name" />
			<InfoRow Label="Address" Value="@cv.Address" />
			<InfoRow Label="Phone" Value="@cv.Phone" />
			<InfoRowLink Label="Email" Value="@cv.Email" IsEmail></InfoRowLink>
			<InfoRowLink Label="GitHub" Value="@cv.GithubLink"></InfoRowLink>
			<InfoRowLink Label="LinkedIn" Value="@cv.LinkedInLink"></InfoRowLink>
		</section>

		<section>
			<h2>Summary</h2>
			<p>@cv.Summary</p>
		</section>

		<section>
			<h2>Skills</h2>
			<ul>
				@foreach (var skill in cv.Skills)
				{
					<li>@skill</li>
				}
			</ul>
		</section>

		<section>
			<h2>Languages</h2>
			<ul>
				@foreach (var language in cv.Languages)
				{
					<li>@language.Title – @language.KnowledgeLevel</li>
				}
			</ul>
		</section>

		<section>
			<h2>Employment History</h2>
			@foreach (var employment in cv.EmploymentHistory)
			{
				<div class="job-entry">
					<p>
						<DateRange StartDate="employment.StartDate" EndDate="employment.EndDate"/>:
						<strong>@employment.Position at @employment.Company</strong>
					</p>
					<ul>
						@foreach (var responsibility in employment.Responsibilities)
						{
							<li>@responsibility</li>
						}
					</ul>
				</div>
			}
		</section>

		<section>
			<h2>Education</h2>
			@foreach (var education in cv.EducationHistory)
			{
				<p>
					<DateRange StartDate="education.StartDate" EndDate="education.EndDate" Format="yyyy"/>:
					<strong>@education.Degree in @education.FieldOfStudy</strong>
					at @education.Institution
				</p>
			}
		</section>

		<section>
			<h2>Commercial Projects</h2>
			@foreach (var project in cv.CommercialProjects)
			{
				<ProjectEntry Project="@project" />
			}
		</section>

		<section>
			<h2>Personal Projects</h2>
			@foreach (var project in cv.PersonalProjects)
			{
				<ProjectEntry Project="@project" />
			}
		</section>

		<section class="clause">
			<p>@cv.Clause</p>
		</section>
	</div>
}
